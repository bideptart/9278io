# Canonical public site origin — the single source of truth for metadata
# (canonical URLs, Open Graph, metadataBase, robots.txt, JSON-LD, sitemap).
# Non-secret; loaded automatically in production builds (incl. Vercel).
NEXT_PUBLIC_SITE_URL=https://www.9278.io

# ── Google Analytics 4 + Google Ads (optional; tags/events are no-ops until set) ──
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=xxxxxxxxxxxxxxxxxxx    # get-started completion conversion label
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=xxxxxxxxxxxxxxxxxxx  # purchase conversion label
# NEXT_PUBLIC_CALL_TRACKING_SRC=https://your-provider/swap.js  # call-tracking placeholder
